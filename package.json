{
  "name": "dsh-ko-locale",
  "version": "0.1.1",
  "description": "Korean (ko) language pack for the DeepSeek Harness desktop and web GUI: registers the ko locale catalog entry and serves Korean copy for every built-in client dictionary.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./dictionaries": {
      "default": "./lib/dictionaries.json"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/dictionaries.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/check-data.mjs",
    "test": "node tools/check-data.mjs && node tools/smoke-test.mjs",
    "extract": "node tools/extract-dictionaries.mjs",
    "chunk": "node tools/prepare-translation.mjs",
    "verify": "node tools/verify-translations.mjs",
    "assemble": "node tools/assemble.mjs",
    "audit": "node tools/audit-untranslated.mjs",
    "probe": "node tools/probe-bundle-route.mjs",
    "prepublishOnly": "node tools/build.mjs && node tools/check-data.mjs"
  },
  "license": "MIT",
  "author": "ara-hwang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ara-hwang/dsh-ko-locale.git"
  },
  "bugs": {
    "url": "https://github.com/ara-hwang/dsh-ko-locale/issues"
  },
  "homepage": "https://github.com/ara-hwang/dsh-ko-locale#readme",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-locale",
    "locale",
    "korean",
    "i18n",
    "localization"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
